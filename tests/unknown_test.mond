(use std/map)
(use std/result [Result])
(use std/unknown [DecodeError])
(use std/bit_array)
(use std/testing [assert_eq])

(let player_data {}
  (map/put "name" "Lucy" (map/new)))

(test
  "unknown/int success"
  (assert_eq (unknown/run (unknown/from 42) (unknown/int)) (Ok 42)))

(test
  "unknown/int failure"
  (assert_eq
    (unknown/run (unknown/from "nope") (unknown/int))
    (Error [(DecodeError :expected "Int" :found "String")])))

(test
  "unknown/float success"
  (assert_eq (unknown/run (unknown/from 1.5) (unknown/float)) (Ok 1.5)))

(test
  "unknown/bool success"
  (assert_eq (unknown/run (unknown/from True) (unknown/bool)) (Ok True)))

(test
  "unknown/list of int success"
  (assert_eq
    (unknown/run (unknown/from [1 2 3]) (unknown/list (unknown/int)))
    (Ok [1 2 3])))

(test
  "unknown/list of int failure"
  (assert_eq
    (unknown/run (unknown/from ["one" "two"]) (unknown/list (unknown/int)))
    (Error [(DecodeError :expected "Int" :found "String")])))

(test
  "unknown/field success"
  (assert_eq
    (unknown/run
      (unknown/from (player_data))
      (unknown/field "name" (unknown/string)))
    (Ok "Lucy")))

(test
  "unknown/field missing"
  (assert_eq
    (unknown/run
      (unknown/from (player_data))
      (unknown/field "email" (unknown/string)))
    (Error [(DecodeError :expected "Field" :found "Nothing")])))

(test
  "unknown/field requires map input"
  (assert_eq
    (unknown/run
      (unknown/from "not-a-map")
      (unknown/field "name" (unknown/string)))
    (Error [(DecodeError :expected "Map" :found "String")])))

(test
  "unknown/bit_array success"
  (let [bits (bit_array/from_string "hi")]
    (assert_eq
      (unknown/run (unknown/from bits) (unknown/bit_array))
      (Ok bits))))

(test
  "unknown/field list index success"
  (assert_eq
    (unknown/run
      (unknown/from ["zero" "one" "two"])
      (unknown/field 1 (unknown/string)))
    (Ok "one")))

(let int_decoder {}
  (unknown/one_of
    (unknown/field "n" (unknown/int))
    [(unknown/int)]))

(test
  "unknown/one_of primary decoder"
  (assert_eq
    (unknown/run
      (unknown/from (map/put "n" 7 (map/new)))
      (int_decoder))
    (Ok 7)))

(test
  "unknown/one_of fallback decoder"
  (assert_eq
    (unknown/run (unknown/from 9) (int_decoder))
    (Ok 9)))
