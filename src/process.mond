(use unknown [Unknown])
(use result [Result])
(use option [Option])
(use port [Port])

;;; A process identifier.
(pub extern type Pid)

;;; A process name.
(pub extern type ['m] Name)

;;; Monitor reference.
(pub extern type Monitor)

;;; Timer reference.
(pub extern type Timer)

;;; Payload of a subject.
(pub type SubjectPayload
  [(:owner ~ Pid)
   (:tag ~ Unknown)])

;;; A subject is what processes use to communicate with each other.
(pub type ['m] Subject
  [(Subject ~ SubjectPayload)
   (NamedSubject ~ Name 'm)])

;;; Structured error information for process operations.
(pub type ErlangErrorPayload
  [(:class ~ String)
   (:reason ~ Unknown)])

(pub type ProcessError
  [InvalidPid
   InvalidName
   ProcessNotAlive
   NameAlreadyRegistered
   NameNotRegistered
   InvalidSubject
   NotSubjectOwner
   Timeout
   InvalidTimeout
   InvalidDelay
   (ErlangError ~ ErlangErrorPayload)])

;;; Stable string tag for branching and logging process errors.
(pub let error_kind {err}
  (match err
    InvalidPid ~> "invalid_pid"
    InvalidName ~> "invalid_name"
    ProcessNotAlive ~> "process_not_alive"
    NameAlreadyRegistered ~> "name_already_registered"
    NameNotRegistered ~> "name_not_registered"
    InvalidSubject ~> "invalid_subject"
    NotSubjectOwner ~> "not_subject_owner"
    Timeout ~> "timeout"
    InvalidTimeout ~> "invalid_timeout"
    InvalidDelay ~> "invalid_delay"
    (ErlangError _) ~> "erlang_error"))

;;; Extract Erlang exception details when the error comes from an exception.
(pub let erlang_error_payload {err}
  (match err
    (ErlangError payload) ~> (Some payload)
    _ ~> None))

;;; Get the current process identifier.
(pub extern let self ~ (Unit -> Pid) erlang/self)

;;; Spawn a linked process.
(pub extern let spawn ~ ((Unit -> Unit) -> Pid) mond_process_helpers/spawn)

;;; Spawn an unlinked process.
(pub extern let spawn_unlinked ~ ((Unit -> Unit) -> Pid) mond_process_helpers/spawn_unlinked)

;;; Compatibility alias for older callers.
(pub extern let spawn_linked ~ ((Unit -> Unit) -> Pid) mond_process_helpers/spawn)

;;; Construct a globally named subject.
(pub extern let new_name ~ (String -> Name 'm) mond_process_helpers/new_name)

;;; Wrap a name as a subject.
(pub extern let named_subject ~ (Name 'm -> Subject 'm) mond_process_helpers/named_subject)

;;; Get the name of a subject, returning an error if it doesn't have one.
(pub let subject_name {subject}
  (match subject
    (NamedSubject name) ~> (Ok name)
    (Subject _) ~> (Error ())))

;;; Create a fresh typed subject owned by the current process.
(pub extern let new_subject ~ (Unit -> Subject 'm) mond_process_helpers/new_subject)

;;; Look up a process by registered name, returning the pid if it exists.
(pub extern let named ~ (Name 'm -> Result Pid ProcessError) mond_process_helpers/process_named)

;;; Get the owner process of a subject.
(pub let subject_owner {subject}
  (match subject
    (NamedSubject name) ~> (named name)
    (Subject payload) ~> (Ok (:owner payload))))

;;; Register a process under a given name.
(pub extern let register ~ (Pid -> Name 'm -> (Result Unit ProcessError)) mond_process_helpers/register_process)

;;; Unregister a name.
(pub extern let unregister ~ (Name 'm -> (Result Unit ProcessError)) mond_process_helpers/unregister_process)

;;; Send a typed message to a subject.
(pub extern let send ~ (Subject 'm -> 'm -> (Result Unit ProcessError)) mond_process_helpers/send)

;;; Receive the next message for this subject, timing out after N milliseconds.
(pub extern let receive_timeout ~ (Subject 'm
  -> Int
  -> (Result 'm ProcessError)) mond_process_helpers/perform_receive)

;;; Receive a message for this subject, waiting forever.
(pub extern let receive_forever ~ (Subject 'm -> (Result 'm ProcessError)) mond_process_helpers/perform_receive_forever)

;;; A type that enables a process to wait for messages from multiple subjects
;;; at the same time, returning whichever message arrives first.
(pub extern type ['p] Selector)

;;; Exit reasons.
(pub type ExitReason
  [Normal
   Killed
   (Abnormal ~ Unknown)])

;;; Trapped exit message payload.
(pub type ExitMessage
  [(:pid ~ Pid)
   (:reason ~ ExitReason)])

(type ProcessDownPayload
  [(:monitor ~ Monitor)
   (:pid ~ Pid)
   (:reason ~ ExitReason)])

(type PortDownPayload
  [(:monitor ~ Monitor)
   (:port ~ Port)
   (:reason ~ ExitReason)])

;;; Monitor down messages.
(pub type Down
  [(ProcessDown ~ ProcessDownPayload)
   (PortDown ~ PortDownPayload)])

;;; Create a new selector.
(pub extern let new_selector ~ (Unit -> Selector 'p) mond_process_helpers/new_selector)

;;; Receive using a selector with timeout.
(pub extern let selector_receive ~ (Selector 'p
  -> Int
  -> (Result 'p ProcessError)) mond_process_helpers/selector_receive)

;;; Receive using a selector forever.
(pub extern let selector_receive_forever ~ (Selector 'p -> 'p) mond_process_helpers/selector_receive_forever)

;;; Map selector payloads.
(extern let map_selector_impl ~ (Selector 'a -> ('a -> 'b) -> Selector 'b) mond_process_helpers/map_selector)

(pub let map_selector {mapper selector}
  (map_selector_impl selector mapper))

;;; Merge selectors, preferring handlers from the second selector.
(extern let merge_selector_impl ~ (Selector 'a -> Selector 'a -> Selector 'a) mond_process_helpers/merge_selector)

(pub let merge_selector {other selector}
  (merge_selector_impl selector other))

;;; Add a subject to a selector with payload mapping.
(extern let select_map_impl ~ (Selector 'p
  -> Subject 'm
  -> ('m -> 'p)
  -> Selector 'p) mond_process_helpers/select_map)

(pub let select_map {subject mapper selector}
  (select_map_impl selector subject mapper))

;;; Add a subject to a selector.
(pub let select {subject selector}
  (select_map subject (f {x} -> x) selector))

;;; Remove a subject from a selector.
(extern let deselect_impl ~ (Selector 'p -> Subject 'm -> Selector 'p) mond_process_helpers/deselect)

(pub let deselect {subject selector}
  (deselect_impl selector subject))

;;; Add a tuple-tag/arity handler to a selector.
(extern let select_record_impl ~ (Selector 'p
  -> 'tag
  -> Int
  -> (Unknown -> 'p)
  -> Selector 'p) mond_process_helpers/select_record)

(pub let select_record {tag arity mapper selector}
  (select_record_impl selector tag arity mapper))

;;; Add a catch-all selector handler.
(extern let select_other_impl ~ (Selector 'p -> (Unknown -> 'p) -> Selector 'p) mond_process_helpers/select_other)

(pub let select_other {mapper selector}
  (select_other_impl selector mapper))

;;; Add a trapped exit handler.
(extern let select_trapped_exits_impl ~ (Selector 'p
  -> (ExitMessage -> 'p)
  -> Selector 'p) mond_process_helpers/select_trapped_exits)

(pub let select_trapped_exits {mapper selector}
  (select_trapped_exits_impl selector mapper))

;;; Add a handler for a specific monitor.
(extern let select_specific_monitor_impl ~ (Selector 'p
  -> Monitor
  -> (Down -> 'p)
  -> Selector 'p) mond_process_helpers/select_specific_monitor)

(pub let select_specific_monitor {monitor_ref mapper selector}
  (select_specific_monitor_impl selector monitor_ref mapper))

;;; Remove a specific monitor handler from a selector.
(extern let deselect_specific_monitor_impl ~ (Selector 'p
  -> Monitor
  -> Selector 'p) mond_process_helpers/deselect_specific_monitor)

(pub let deselect_specific_monitor {monitor_ref selector}
  (deselect_specific_monitor_impl selector monitor_ref))

;;; Add a handler for all down messages.
(extern let select_monitors_impl ~ (Selector 'p -> (Down -> 'p) -> Selector 'p) mond_process_helpers/select_monitors)

(pub let select_monitors {mapper selector}
  (select_monitors_impl selector mapper))

;;; Discard all messages in the current process mailbox.
(pub extern let flush_messages ~ (Unit -> Unit) mond_process_helpers/flush_messages)

;;; Sleep for N milliseconds.
(pub extern let sleep ~ (Int -> Unit) timer/sleep)

;;; Sleep forever.
(pub extern let sleep_forever ~ (Unit -> Unit) mond_process_helpers/sleep_forever)

;;; Check if a process is alive.
(pub extern let is_alive ~ (Pid -> Bool) erlang/is_process_alive)

(type ProcessMonitorFlag
  [Process])

(extern let erlang_monitor_process ~ (ProcessMonitorFlag -> Pid -> Monitor) erlang/monitor)

;;; Start monitoring a process so that when the monitored process exits a
;;; message is sent to the monitoring process.
(pub let monitor {pid}
  (erlang_monitor_process Process pid))

;;; Stop monitoring a process.
(pub extern let demonitor_process ~ (Monitor -> Unit) mond_process_helpers/demonitor_process)

;;; Link to a process, returning False if it is not alive.
(pub extern let link ~ (Pid -> Bool) mond_process_helpers/link)

;;; Remove a link to a process.
(extern let erlang_unlink ~ (Pid -> Bool) erlang/unlink)

(pub let unlink {pid}
  (do (erlang_unlink pid))
  ())

;;; Set whether this process traps exits.
(pub extern let trap_exits ~ (Bool -> Unit) mond_process_helpers/trap_exits)

;;; Send a message after a delay.
(pub extern let send_after ~ (Subject 'm
  -> Int
  -> 'm
  -> (Result Timer ProcessError)) mond_process_helpers/send_after)

;;; Result of cancelling a timer.
(pub type Cancelled
  [TimerNotFound
   (Cancelled ~ Int)])

;;; Cancel a timer.
(pub extern let cancel_timer ~ (Timer -> Cancelled) mond_process_helpers/cancel_timer)

(type KillFlag
  [Kill])

;;; Kill a process with an untrappable signal.
(extern let erlang_kill ~ (Pid -> KillFlag -> Bool) erlang/exit)

(pub let kill {pid}
  (do (erlang_kill pid Kill))
  ())

;;; Send a normal exit signal.
(extern let erlang_send_exit ~ (Pid -> 'a -> Bool) erlang/exit)

(pub let send_exit {pid}
  (do (erlang_send_exit pid Normal))
  ())

;;; Send an abnormal exit signal with a reason value.
(pub let send_abnormal_exit {pid reason}
  (do (erlang_send_exit pid reason))
  ())

(let perform_call {subject make_request wait_for_reply}
  (let [reply_subject (new_subject)]
    (let? [_ (send subject (make_request reply_subject))]
      (wait_for_reply reply_subject))))

;;; Send a request message and wait for a reply with timeout.
(pub let call {subject timeout make_request}
  (perform_call
    subject
    make_request
    (f {reply_subject} -> (receive_timeout reply_subject timeout))))

;;; Send a request message and wait forever for a reply.
(pub let call_forever {subject make_request}
  (perform_call
    subject
    make_request
    (f {reply_subject} -> (receive_forever reply_subject))))
