(use result [Result])
(use bit_array [BitArray])

;;; Opaque runtime-backed value from an untyped boundary.
(pub extern type Unknown)

;;; Opaque decoder for turning Unknown values into typed values.
(pub extern type ['a] Decoder)

;;; Minimal structured decode error.
(pub type DecodeError
  [(:expected ~ String)
   (:found ~ String)])

;;; Lift a typed Mond value into Unknown.
(pub extern let from ~ ('a -> Unknown) mond_unknown_helpers/from)

;;; Run a decoder against an Unknown value.
(pub extern let run ~ (Unknown -> Decoder 'a -> (Result 'a (List DecodeError))) mond_unknown_helpers/run)

;;; Primitive decoders.
(pub extern let string ~ (Unit -> Decoder String) mond_unknown_helpers/string)
(pub extern let int ~ (Unit -> Decoder Int) mond_unknown_helpers/int)
(pub extern let float ~ (Unit -> Decoder Float) mond_unknown_helpers/float)
(pub extern let bool ~ (Unit -> Decoder Bool) mond_unknown_helpers/bool)
(pub extern let bit_array ~ (Unit -> Decoder BitArray) mond_unknown_helpers/bit_array)
(pub extern let dynamic ~ (Unit -> Decoder Unknown) mond_unknown_helpers/dynamic)

;;; Structural decoders.
(pub extern let list ~ ((Decoder 'a) -> (Decoder (List 'a))) mond_unknown_helpers/list)
(pub extern let field ~ ('k -> (Decoder 'a) -> (Decoder 'a)) mond_unknown_helpers/field)
(pub extern let one_of ~ ((Decoder 'a) -> (List (Decoder 'a)) -> (Decoder 'a)) mond_unknown_helpers/one_of)

;;; Primitive encoders 
(pub extern let from_string ~ (String -> Unknown) mond_unknown_helpers/identity)
