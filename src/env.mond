;;; Environment helpers.

;;; Normalized operating system identifiers derived from Erlang `os:type()`.
(pub type Os
  [Linux
   Mac
   Windows
   Other])

;;; Returns the current operating system.
;;; Mapping from Erlang `os:type()`:
;;; - `{unix, linux}` -> `Linux`
;;; - `{unix, darwin}` -> `Mac`
;;; - `{win32, _}` -> `Windows`
;;; - everything else -> `Other`
(pub extern let os ~ (Unit -> Os) mond_env_helpers/current_os)
