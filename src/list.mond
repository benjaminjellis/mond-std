;;; list.mond — list helpers backed by Erlang lists
(use option [Option])
(use pair [Pair])
(use result [Result])

;;; Returns the number of elements in the list.
(pub extern let length ~ ((List 'a) -> Int) erlang/length)

;;; Returns a new list with the elements in reverse order.
(pub extern let reverse ~ ((List 'a) -> (List 'a)) lists/reverse)

;;; Concatenates two lists.
(pub extern let concat ~ ((List 'a) -> (List 'a) -> (List 'a)) lists/append)

;;; Returns a new list with the item appended at the end.
(pub let append {item list}
  (concat list [item]))

;;; Returns a new list with the item prepended at the front.
(pub extern let prepend ~ ('a -> (List 'a) -> (List 'a)) mond_list_helpers/prepend)

;;; Removes the first element matching the predicate.
;;; Returns the removed element (if found) and the remaining list.
(pub extern let pop_first ~ (('a -> Bool)
  -> (List 'a)
  -> (Pair (Option 'a) (List 'a))) mond_list_helpers/pop_first)

;;; Replaces the first element matching the predicate.
;;; Returns the original list unchanged if no element matches.
(pub extern let replace_first ~ (('a -> Bool) -> 'a -> (List 'a) -> (List 'a)) mond_list_helpers/replace_first)

;;; Replaces the first element matching the predicate.
;;; If no element matches, appends the replacement at the end.
(pub extern let upsert_first ~ (('a -> Bool) -> 'a -> (List 'a) -> (List 'a)) mond_list_helpers/upsert_first)

;;; Returns the Nth element of the list (0-indexed), or None if out of bounds.
(pub extern let nth ~ (Int -> (List 'a) -> Option 'a) mond_list_helpers/nth)

;;; Returns true if the element is in the list.
(pub extern let member ~ ('a -> (List 'a) -> Bool) lists/member)

;;; Applies a function to each element, returning a new list.
(pub extern let map ~ (('a -> 'b) -> (List 'a) -> (List 'b)) lists/map)

;;; Maps each element to a list and concatenates the results.
(pub extern let flat_map ~ (('a -> (List 'b)) -> (List 'a) -> (List 'b)) mond_list_helpers/flat_map)

;;; Returns a list of elements for which the predicate returns true.
(pub extern let filter ~ (('a -> Bool) -> (List 'a) -> (List 'a)) lists/filter)

;;; Maps each element and keeps only the successful values.
;;; Values wrapped in `Error` are dropped.
(pub extern let filter_map ~ (('a -> Result 'b 'error)
  -> (List 'a)
  -> (List 'b)) mond_list_helpers/filter_map)

;;; Left fold: foldl f acc [x1 x2 x3] = f x3 (f x2 (f x1 acc))
(pub extern let foldl ~ (('a -> 'b -> 'b) -> 'b -> (List 'a) -> 'b) mond_list_helpers/foldl)

;;; Right fold: foldr f acc [x1 x2 x3] = f x1 (f x2 (f x3 acc))
(pub extern let foldr ~ (('a -> 'b -> 'b) -> 'b -> (List 'a) -> 'b) mond_list_helpers/foldr)

;;; Returns a sorted list (uses the natural Erlang term ordering).
(pub extern let sort ~ ((List 'a) -> (List 'a)) lists/sort)

;;; Flattens a list of lists into a single list.
(pub extern let flatten ~ ((List (List 'a)) -> (List 'a)) lists/flatten)

;;; Returns the last element in the given list.
;;;  Returns `Error ()` if the list is empty.
(pub let last {list}
  (match list
    [] ~> (Error ())
    [last] ~> (Ok last)
    [_ | t] ~> (last t)))
